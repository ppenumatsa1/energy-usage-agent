# Local development only. Copy to .env if you want fixed values; scripts/dev.py works without it.
# Never put real customer data, tenant IDs or secrets in this file.

# Shared
ENVIRONMENT=local
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-local-only-at-least-32-characters

# energy-service (port 8001 locally)
AUTH_AUDIENCE=energy-service
REPOSITORY=postgres            # or memory
DATABASE_URL=postgresql://energy_app:local-dev-only@localhost:5432/postgres

# app-api (port 8000 locally)
AGENT_MODE=fake                # foundry needs FOUNDRY_PROJECT_ENDPOINT and an az login
OBO_CREDENTIAL=dev
ENERGY_SERVICE_URL=http://localhost:8001
APP_DATABASE_URL=postgresql://app_api_app:local-dev-only@localhost:5432/postgres
RATE_LIMIT_PER_MINUTE=20
HISTORY_RETENTION_DAYS=30
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_AGENT_NAME=energy-usage-agent

# scripts
LOCAL_DB_APP_PASSWORD=local-dev-only
