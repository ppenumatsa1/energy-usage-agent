{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "aiLocation": {
      "value": "${AZURE_AI_LOCATION=}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalName": {
      "value": "${AZURE_PRINCIPAL_NAME=}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "clientIpAddress": {
      "value": "${CLIENT_IP_ADDRESS=}"
    },
    "pipelinePrincipalId": {
      "value": "${AZURE_PIPELINE_PRINCIPAL_ID=}"
    },
    "preauthorizeAzureCli": {
      "value": "${ENTRA_PREAUTHORIZE_AZURE_CLI=true}"
    },
    "modelName": {
      "value": "${AZURE_AI_MODEL_NAME=gpt-5.6-luna}"
    },
    "modelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2026-07-09}"
    },
    "modelSkuName": {
      "value": "${AZURE_AI_MODEL_SKU=GlobalStandard}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=30}"
    },
    "traceContent": {
      "value": "${TRACE_CONTENT=false}"
    },
    "webExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    },
    "appApiExists": {
      "value": "${SERVICE_APP_API_RESOURCE_EXISTS=false}"
    },
    "energyServiceExists": {
      "value": "${SERVICE_ENERGY_SERVICE_RESOURCE_EXISTS=false}"
    }
  }
}
